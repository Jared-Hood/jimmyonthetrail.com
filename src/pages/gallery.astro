---
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import JsonLd from '../components/JsonLd.astro';
import { pages, site } from '../data/site';
import { galleryAlt } from '../data/gallery-alt';
import { buildGalleryRows, cellAspect } from '../lib/galleryRows';

const modules = import.meta.glob<ImageMetadata>('/src/assets/gallery/*.png', { eager: true, import: 'default' });

const photos = await Promise.all(
  Object.entries(modules)
    .map(([path, src]) => ({ number: Number(/gallery(\d+)\.png$/.exec(path)?.[1] ?? 0), src }))
    .sort((a, b) => a.number - b.number)
    .map(async ({ number, src }) => {
      // Viewer image: only fetched when the photo is opened (sources are 768px wide at most).
      const viewer = await getImage({
        src,
        widths: [480, Math.min(src.width, 1600)],
        format: 'webp',
        quality: 75,
      });
      const alt = galleryAlt[number];
      if (!alt) throw new Error(`Missing alt text for gallery${number}.png in src/data/gallery-alt.ts`);
      return { src, number, alt, aspect: src.width / src.height, viewerSrc: viewer.src, viewerSrcset: viewer.srcSet.attribute };
    }),
);

type Photo = (typeof photos)[number];

// Rows of varied patterns (see src/lib/galleryRows.ts); each photo gets its share of the row
// width for the `sizes` hint, and a running index for the viewer.
const rows = buildGalleryRows(photos);
const indexOf = new Map(photos.map((photo, i) => [photo, i]));
const sizesFor = (fraction: number) => {
  const f = fraction.toFixed(3);
  // Phones get a slightly understated slot (two columns ≈ 45vw each) so 3x screens load
  // 400px thumbnails rather than 600px; the full-size photo is one tap away in the viewer.
  return `(min-width: 72rem) ${Math.round(1104 * fraction)}px, (min-width: 40rem) calc((100vw - 3rem) * ${f}), 33vw`;
};
const rowCells = rows.map((row) => {
  const total = row.cells.reduce((sum, cell) => sum + cellAspect(cell), 0);
  return {
    pattern: row.pattern,
    cells: row.cells.map((cell) => ({
      grow: cellAspect(cell),
      photos: (cell.kind === 'photo' ? [cell.photo] : cell.photos) as Photo[],
      stacked: cell.kind === 'stack',
      fraction: cellAspect(cell) / total,
    })),
  };
});

const galleryLd = {
  '@context': 'https://schema.org',
  '@type': 'ImageGallery',
  name: `${site.name} Photo Gallery`,
  url: `${site.url}/gallery`,
  description: pages.gallery.description,
  image: photos.map((photo) => ({
    '@type': 'ImageObject',
    contentUrl: new URL(photo.viewerSrc, site.url).href,
    caption: photo.alt,
  })),
};
---

<BaseLayout page={pages.gallery} image={photos[0]?.src}>
  <JsonLd slot="head" data={galleryLd} />
  <PageHeader title="Gallery" eyebrow={`${photos.length} photos from the trail`} />

  <section class="py-6 md:py-10" aria-label="Photos">
    <div class="container mx-auto max-w-6xl px-4 sm:px-6">
      <div class="gallery">
        {
          rowCells.map((row) => (
            <div class:list={['gallery-row', `gallery-row--${row.pattern}`]} data-reveal>
              {row.cells.map((cell) => (
                <div class:list={[cell.stacked ? 'gallery-stack' : 'contents']} style={`--grow: ${cell.grow.toFixed(4)}`}>
                  {cell.photos.map((photo) => (
                    <a
                      href={photo.viewerSrc}
                      class="gallery-cell group block overflow-hidden rounded-photo bg-bark"
                      style={`--grow: ${photo.aspect.toFixed(4)}; --aspect: ${photo.aspect.toFixed(4)}`}
                      data-lightbox-index={indexOf.get(photo)}
                      data-srcset={photo.viewerSrcset}
                    >
                      <Image
                        src={photo.src}
                        alt={photo.alt}
                        format="webp"
                        widths={[200, 300, 400, 600]}
                        width={600}
                        quality={62}
                        loading="lazy"
                        decoding="async"
                        sizes={sizesFor(cell.fraction)}
                        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.02] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
                      />
                    </a>
                  ))}
                </div>
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <dialog
    id="lightbox"
    aria-labelledby="lightbox-title"
    class="m-0 h-dvh max-h-none w-screen max-w-none bg-ink-900 p-0 text-cream backdrop:bg-ink-900/80"
  >
    <div class="flex h-full flex-col">
      <div class="flex items-center justify-between gap-4 px-4 py-3 sm:px-6">
        <h2 id="lightbox-title" class="sr-only">Photo viewer</h2>
        <p id="lightbox-count" class="text-sm text-cream-200 tabular-nums" aria-live="polite"></p>
        <button
          type="button"
          data-close
          class="inline-flex h-11 items-center gap-2 px-2 text-sm font-medium tracking-[0.06em] text-cream hover:text-rust-300"
        >
          Close <span aria-hidden="true" class="text-xl leading-none">×</span>
        </button>
      </div>
      <figure data-stage class="relative m-0 flex min-h-0 flex-1 touch-pan-y flex-col items-center justify-center gap-3 pb-4 select-none sm:px-20 sm:pb-6">
        <img
          id="lightbox-image"
          alt=""
          sizes="(max-width: 48rem) 100vw, 75vh"
          decoding="async"
          draggable="false"
          class="min-h-0 max-w-full flex-1 object-contain transition-opacity duration-200"
        />
        <figcaption id="lightbox-caption" class="max-w-xl px-4 text-center text-sm text-cream-200"></figcaption>
        <button
          type="button"
          data-prev
          aria-label="Previous photo"
          class="absolute top-1/2 left-2 h-12 w-12 -translate-y-1/2 rounded-full bg-ink-900/70 text-3xl leading-none text-cream hover:text-rust-300 sm:left-4"
        >
          ‹
        </button>
        <button
          type="button"
          data-next
          aria-label="Next photo"
          class="absolute top-1/2 right-2 h-12 w-12 -translate-y-1/2 rounded-full bg-ink-900/70 text-3xl leading-none text-cream hover:text-rust-300 sm:right-4"
        >
          ›
        </button>
      </figure>
    </div>
  </dialog>
</BaseLayout>

<style>
  /* Phones: a simple two-column masonry (rows and stacks dissolve into the columns). */
  .gallery {
    columns: 2;
    column-gap: 0.5rem;
  }

  .gallery-row,
  .gallery-stack {
    display: contents;
  }

  .gallery-cell {
    aspect-ratio: var(--aspect);
    margin-bottom: 0.5rem;
    break-inside: avoid;
  }

  /* From 640px: editorial rows. Widths follow each photo's aspect ratio, so nothing is cropped. */
  @media (min-width: 40rem) {
    .gallery {
      columns: auto;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .gallery-row {
      display: flex;
      gap: 0.75rem;
    }

    .gallery-row > .contents > .gallery-cell,
    .gallery-stack {
      flex: var(--grow) 1 0;
      min-width: 0;
    }

    .gallery-stack {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .gallery-stack > .gallery-cell {
      flex: 1 1 0;
      aspect-ratio: auto;
    }

    .gallery-cell {
      margin-bottom: 0;
    }

    .gallery-row--solo > .contents > .gallery-cell {
      flex: 0 1 50%;
    }
  }

  @media (min-width: 64rem) {
    .gallery,
    .gallery-row,
    .gallery-stack {
      gap: 1rem;
    }
  }
</style>

<script>
  const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
  const image = document.getElementById('lightbox-image') as HTMLImageElement | null;
  const counter = document.getElementById('lightbox-count');
  const caption = document.getElementById('lightbox-caption');
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-lightbox-index]'));

  // Without <dialog> support the links simply open the full-size image.
  if (dialog && image && typeof dialog.showModal === 'function') {
    let current = 0;
    let opener: HTMLElement | null = null;
    const preloaded = new Set<number>();

    const wrap = (index: number) => (index + links.length) % links.length;

    /** Warms the cache for a neighbour, letting the browser pick the same srcset size. */
    const preload = (index: number) => {
      const i = wrap(index);
      if (preloaded.has(i)) return;
      preloaded.add(i);
      const img = new Image();
      img.sizes = image.sizes;
      img.srcset = links[i].dataset.srcset ?? '';
      img.src = links[i].href;
    };

    const show = (index: number) => {
      current = wrap(index);
      const link = links[current];
      const alt = link.querySelector('img')?.alt ?? '';
      image.srcset = link.dataset.srcset ?? '';
      image.src = link.href;
      image.alt = alt;
      if (caption) caption.textContent = alt;
      if (counter) counter.textContent = `Photo ${current + 1} of ${links.length}`;
      preload(current + 1);
      preload(current - 1);
    };

    links.forEach((link, index) => {
      link.addEventListener('click', (event) => {
        event.preventDefault();
        opener = link;
        show(index);
        // showModal() makes the rest of the page inert, so focus stays inside the viewer.
        dialog.showModal();
      });
    });

    dialog.querySelector('[data-prev]')?.addEventListener('click', () => show(current - 1));
    dialog.querySelector('[data-next]')?.addEventListener('click', () => show(current + 1));
    dialog.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());

    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') show(current - 1);
      if (event.key === 'ArrowRight') show(current + 1);
    });

    // Swipe left/right on touch screens (pointer events; vertical moves are ignored).
    const stage = dialog.querySelector<HTMLElement>('[data-stage]');
    let startX = 0;
    let startY = 0;
    let tracking = false;
    let swiped = false;
    stage?.addEventListener('pointerdown', (event) => {
      if (event.pointerType === 'mouse') return;
      tracking = true;
      swiped = false;
      startX = event.clientX;
      startY = event.clientY;
    });
    stage?.addEventListener('pointerup', (event) => {
      if (!tracking) return;
      tracking = false;
      const dx = event.clientX - startX;
      const dy = event.clientY - startY;
      if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy) * 1.5) {
        swiped = true;
        show(current + (dx < 0 ? 1 : -1));
      }
    });
    stage?.addEventListener('pointercancel', () => (tracking = false));

    // Clicking empty space around the photo closes the viewer.
    dialog.addEventListener('click', (event) => {
      if (swiped) {
        swiped = false;
        return;
      }
      const target = event.target as HTMLElement;
      if (target === dialog || target.hasAttribute('data-stage')) dialog.close();
    });

    dialog.addEventListener('close', () => {
      image.removeAttribute('srcset');
      image.removeAttribute('src');
      // Return focus to the thumbnail of the photo that was last shown (or the one that opened it).
      (links[current] ?? opener)?.focus();
      opener = null;
    });
  }
</script>
