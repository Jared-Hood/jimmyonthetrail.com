---
import BaseLayout from '../layouts/BaseLayout.astro';

const page = {
  name: 'Page Not Found',
  description: "This page wandered off the trail. Head back to Jimmy on the Trail's home page.",
  slug: '404',
};
---

<BaseLayout page={page} noindex>
  <section class="py-section">
    <div class="page-container">
      <p class="eyebrow mb-4">404</p>
      <h1 class="font-display text-3xl font-normal text-cream sm:text-[clamp(2.75rem,1.8rem+3vw,4.25rem)] sm:leading-none">
        Off the trail
      </h1>
      <p class="mt-8 max-w-[36rem] text-lg leading-relaxed text-cream-200">
        We couldn't find that page. It may have moved when the site was rebuilt.
      </p>
      <p class="mt-10 flex flex-wrap gap-x-8 gap-y-3 font-medium">
        <a href="/" class="text-cream underline decoration-rust-400 underline-offset-4 hover:decoration-cream">Return to Home</a>
        <a href="/blog" class="text-cream-200 hover:text-cream">Read the blog</a>
      </p>
    </div>
  </section>
</BaseLayout>
