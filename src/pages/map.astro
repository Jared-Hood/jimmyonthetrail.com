---
import BaseLayout from '../layouts/BaseLayout.astro';
import TrailMap from '../components/TrailMap.astro';
import MilesProgress from '../components/MilesProgress.astro';
import { pages } from '../data/site';
import { TRAIL_TOTAL_MILES, getDays, totalMiles } from '../lib/days';

const traveled = totalMiles(await getDays());
---

<BaseLayout page={pages.map}>
  <!-- Compact strip so the map itself is the hero. Its height is fixed (map-strip) so the
       embed below can fill the rest of the viewport. -->
  <div class="flex h-24 items-center border-b border-cream/15 md:h-16">
    <div class="container mx-auto flex flex-col gap-2 px-4 sm:px-6 md:flex-row md:items-center md:justify-between md:gap-8">
      <h1 class="font-display text-[1.75rem] leading-none font-normal text-cream md:text-[2rem]">Where is Jimmy?</h1>
      <MilesProgress traveled={traveled} total={TRAIL_TOTAL_MILES} />
    </div>
  </div>

  <!-- Phones: ~70% of the screen so the footer peeks in. From md: viewport minus header
       (5rem / 6rem at lg), strip (4rem) and credit (~2rem). -->
  <TrailMap class="h-[70dvh] min-h-[26rem] md:h-[calc(100dvh-11rem)] lg:h-[calc(100dvh-12rem)] lg:min-h-[32rem]" />
</BaseLayout>
