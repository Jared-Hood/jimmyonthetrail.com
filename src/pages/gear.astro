---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { pages } from '../data/site';
import { baseWeight, gearIntro, gearSections } from '../data/gear';
---

<BaseLayout page={pages.gear}>
  <PageHeader title="Gear" eyebrow="What I carried">
    <div class="mt-6 grid gap-6 md:mt-8 lg:grid-cols-12 lg:gap-x-12">
      <p class="prose prose-trail lg:col-span-7">{gearIntro}</p>

      <div class="self-start border-l border-rust-400 pl-5 lg:col-span-4 lg:col-start-9">
        <p class="text-xs font-medium tracking-[0.14em] text-cream-400 uppercase">Base Weight</p>
        <p class="mt-2 text-[clamp(2rem,1.4rem+2vw,2.75rem)] leading-none font-medium tracking-tight text-cream">
          {baseWeight.value}
        </p>
        <p class="mt-3 text-sm text-cream-400">({baseWeight.note})</p>
      </div>
    </div>
  </PageHeader>

  <section class="py-8 md:py-12" aria-label="Gear list">
    <div class="container mx-auto px-4 sm:px-6 columns-1 gap-x-12 md:columns-2 xl:columns-3">
      {
        gearSections.map((section, index) => {
          const id = `gear-${section.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
          return (
            <section class="mb-10 break-inside-avoid" data-reveal aria-labelledby={id}>
              <div class="mb-4 flex items-baseline gap-4 border-b border-cream/25 pb-3">
                <span class="text-xs font-medium text-rust-300 tabular-nums" aria-hidden="true">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <h2 id={id} class="text-sm font-medium tracking-[0.14em] text-cream uppercase">
                  {section.title}
                </h2>
                <span class="ml-auto text-xs text-cream-600 tabular-nums">
                  {section.items.length} {section.items.length === 1 ? 'item' : 'items'}
                </span>
              </div>
              <ul class="divide-y divide-cream/10">
                {section.items.map((item) => (
                  <li class="py-2.5 leading-snug text-cream-200">{item}</li>
                ))}
              </ul>
            </section>
          );
        })
      }
    </div>
  </section>
</BaseLayout>
