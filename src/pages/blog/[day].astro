---
import type { GetStaticPaths } from 'astro';
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PhotoGrid from '../../components/PhotoGrid.astro';
import JsonLd from '../../components/JsonLd.astro';
import DayCard from '../../components/DayCard.astro';
import { hiker, site } from '../../data/site';
import { formatDate, formatMiles, getDayInfo, isoDate, resolveDayImage, type DayInfo } from '../../lib/days';

export const getStaticPaths = (async () => {
  const days = await getDayInfo();
  return days.map((info, index) => ({
    params: { day: String(info.entry.data.day) },
    props: { info, prev: days[index - 1], next: days[index + 1] },
  }));
}) satisfies GetStaticPaths;

interface Props {
  info: DayInfo;
  prev?: DayInfo;
  next?: DayInfo;
}

const { info, prev, next } = Astro.props;
const { entry, state, milesSoFar, milesToGo } = info;
const { day, name, date, lat, long, mileage, altitude, images } = entry.data;

const description = `On day ${day} I traveled through ${name}!`;
const page = { name: `Day ${day}, ${name}`, description, slug: `blog/${day}` };
const hasText = Boolean(entry.body?.trim());
const { Content } = await render(entry);

const photos = images.map((image) => ({ src: resolveDayImage(image.src), alt: image.alt }));
const [lead, ...morePhotos] = photos;

const siteUrl = Astro.site ?? new URL(site.url);
const url = new URL(`/blog/${day}`, siteUrl).href;
const jsonLdImage = photos[0]
  ? new URL((await getImage({ src: photos[0].src, width: 1200, format: 'jpg', quality: 80 })).src, siteUrl).href
  : undefined;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: `Day ${day}, ${name}`,
  description,
  datePublished: isoDate(date),
  url,
  mainEntityOfPage: url,
  author: { '@type': 'Person', name: hiker.name, alternateName: hiker.trailName, url: new URL('/', siteUrl).href },
  ...(jsonLdImage && { image: jsonLdImage }),
  contentLocation: {
    '@type': 'Place',
    name,
    geo: { '@type': 'GeoCoordinates', latitude: lat, longitude: long },
  },
  isPartOf: { '@type': 'Blog', name: `${site.name} Blog`, url: new URL('/blog', siteUrl).href },
};

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Blog', item: new URL('/blog', siteUrl).href },
    { '@type': 'ListItem', position: 2, name: `Day ${day}`, item: url },
  ],
};

const coordinates = `${Math.abs(lat).toFixed(4)}° ${lat >= 0 ? 'N' : 'S'}, ${Math.abs(long).toFixed(4)}° ${long >= 0 ? 'E' : 'W'}`;
---

<BaseLayout page={page} image={photos[0]?.src} imageAlt={photos[0]?.alt}>
  <JsonLd slot="head" data={[jsonLd, breadcrumbs]} />

  <article class="pb-10 md:pb-16">
    <header class:list={['border-b border-cream/15', !lead && 'bg-bark/40']}>
      <div class:list={['container mx-auto px-4 sm:px-6', lead ? 'pt-6 pb-6 md:pt-8' : 'pt-6 pb-8 md:pt-8 md:pb-12']}>
        <nav aria-label="Breadcrumb" class="mb-6 text-sm md:mb-8">
          <ol class="flex items-center gap-2 text-cream-400">
            <li><a href="/blog" class="hover:text-cream">Blog</a></li>
            <li aria-hidden="true" class="text-cream-600">/</li>
            <li aria-current="page" class="text-cream-200">Day {day}</li>
          </ol>
        </nav>

        <div class:list={['flex gap-5 md:gap-8', lead ? 'items-end' : 'items-end md:items-center']}>
          {
            !lead && (
              <p class="font-display text-[clamp(4.5rem,3rem+7vw,9rem)] leading-[0.8] text-rust-300/90" aria-hidden="true">
                {day}
              </p>
            )
          }
          <div>
            <p class="eyebrow mb-3">Day {day} &middot; {state}{day === 0 && ' · Approach trail'}</p>
            <h1 class="page-title max-w-4xl">{name}</h1>
            <p class="mt-3 text-sm text-cream-400">
              <time datetime={isoDate(date)}>{formatDate(date)}</time>
            </p>
          </div>
        </div>
      </div>
    </header>

    {
      lead && (
        <figure class="container mx-auto mt-6 px-4 sm:px-6">
          <div class="flex justify-center overflow-hidden rounded-photo bg-bark">
            <Image
              src={lead.src}
              alt={lead.alt}
              format="webp"
              widths={[640, 960, 1280, 1600, 2000].filter((w) => w <= lead.src.width)}
              width={Math.min(lead.src.width, 2000)}
              quality={72}
              loading="eager"
              fetchpriority="high"
              sizes="(min-width: 96rem) 1488px, (min-width: 80rem) 1232px, calc(100vw - 2rem)"
              class="max-h-[75vh] w-auto object-contain"
            />
          </div>
          <figcaption class="mt-2 text-xs text-cream-400">{lead.alt}</figcaption>
        </figure>
      )
    }

    <div class="container mx-auto px-4 sm:px-6">
      <dl class="mt-6 grid grid-cols-2 gap-px overflow-hidden rounded-photo border border-cream/15 bg-cream/15 sm:grid-cols-3 lg:grid-cols-5">
        {
          [
            { label: 'Day', value: String(day) },
            { label: 'Miles today', value: formatMiles(mileage) },
            { label: 'State', value: state },
            { label: 'Trail miles so far', value: formatMiles(milesSoFar) },
            { label: 'To Katahdin', value: `${formatMiles(milesToGo)} mi` },
          ].map((stat, i) => (
            <div class:list={['bg-ink px-4 py-3', i === 4 && 'col-span-2 sm:col-span-1']}>
              <dt class="text-[0.7rem] font-medium tracking-[0.14em] text-cream-400 uppercase">{stat.label}</dt>
              <dd class="mt-1 text-lg font-medium text-cream tabular-nums">{stat.value}</dd>
            </div>
          ))
        }
      </dl>
      <p class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-xs text-cream-400 tabular-nums">
        {altitude !== undefined && <span>Elevation {Math.round(altitude).toLocaleString('en-US')} ft</span>}
        <span>
          <span class="sr-only">Latitude {lat}, longitude {long}: </span><span aria-hidden="true">{coordinates}</span>
        </span>
        <a href="/map" class="font-medium text-rust-300 underline decoration-rust-400/60 underline-offset-4 hover:text-cream">
          See on the map
        </a>
      </p>

      <div class="pt-8 md:pt-10">
        {
          hasText ? (
            <div class="prose prose-trail">
              <Content />
            </div>
          ) : (
            <p class="text-cream-400">No journal notes for this day.</p>
          )
        }
      </div>

      {
        morePhotos.length > 0 && (
          <div class="mt-8 md:mt-12" data-reveal>
            <PhotoGrid photos={morePhotos} label={`More photos from day ${day}`} />
          </div>
        )
      }

      <nav aria-label="Day navigation" class="mt-8 grid grid-cols-1 gap-3 border-t border-cream/15 pt-6 sm:grid-cols-2 md:mt-12 md:pt-8">
        <div>{prev && <DayCard day={prev.entry} state={prev.state} label="Previous day" />}</div>
        <div>{next && <DayCard day={next.entry} state={next.state} label="Next day" align="end" />}</div>
      </nav>
    </div>
  </article>
</BaseLayout>
