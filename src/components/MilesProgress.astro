---
import { formatMiles } from '../lib/days';

interface Props {
  traveled: number;
  total: number;
  class?: string;
}

const { traveled, total, class: className } = Astro.props;
const rounded = Math.round(traveled * 100) / 100;
const percent = Math.min(100, (rounded / total) * 100);
---

<div class:list={['flex items-center gap-4', className]}>
  <p class="text-sm whitespace-nowrap text-cream-400">
    <span class="text-lg font-medium text-cream tabular-nums">{formatMiles(rounded)}</span>{' '}/{' '}
    {formatMiles(total)} miles traveled
  </p>
  <div
    class="h-1 min-w-16 flex-1 overflow-hidden rounded-full bg-cream/15 md:w-48 md:flex-none"
    role="progressbar"
    aria-label="Miles traveled"
    aria-valuemin="0"
    aria-valuemax={total}
    aria-valuenow={rounded}
    aria-valuetext={`${formatMiles(rounded)} of ${formatMiles(total)} miles (${Math.round(percent)}%)`}
  >
    <div class="h-full bg-rust-400" style={`width: ${percent}%`}></div>
  </div>
</div>
