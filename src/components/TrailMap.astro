---
/** Trail map: the AdventureMapper embed. Kept in one component so it can be swapped later. */
import { trailMap } from '../data/site';

interface Props {
  /** Height classes for the embed; the map page sizes it to fill the viewport. */
  class?: string;
}

const { class: heightClass = 'h-[min(80vh,720px)] min-h-[480px]' } = Astro.props;
---

<figure class="m-0">
  <iframe
    src={trailMap.embedUrl}
    title={trailMap.title}
    loading="lazy"
    allowfullscreen
    class:list={['block w-full border-0 bg-bark', heightClass]}
  ></iframe>
  <figcaption class="container mx-auto px-4 py-2 text-right text-xs text-cream-600 sm:px-6">
    Map by <a href={trailMap.creditUrl} class="text-cream-400 underline decoration-cream/30 underline-offset-2 hover:text-cream">Adventure Mapper</a>
  </figcaption>
</figure>
