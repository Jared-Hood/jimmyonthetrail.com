---
import trail from '../data/trail.json';
import { getPosts, formatDate, excerpt } from '../lib/blog';
const posts = await getPosts();
// A local Mercator projection keeps the complete route available without a map service.
const project = (lng: number, lat: number) => ({
  x: 70 + ((lng + 85) / 18) * 680,
  y:
    720 -
    ((Math.log(Math.tan(Math.PI / 4 + (lat * Math.PI) / 360)) - 0.62) / 0.29) *
      650,
});
const path = trail
  .map((point, index) => {
    const p = project(point.lng, point.lat);
    return `${index ? 'L' : 'M'}${p.x.toFixed(2)},${p.y.toFixed(2)}`;
  })
  .join(' ');
const states = [
  { name: 'GEORGIA', lat: 34.1, lng: -83.2 },
  { name: 'NORTH CAROLINA', lat: 35.5, lng: -81.4 },
  { name: 'TENNESSEE', lat: 36.4, lng: -84.1 },
  { name: 'VIRGINIA', lat: 37.2, lng: -79.5 },
  { name: 'WEST VIRGINIA', lat: 38.9, lng: -80.6 },
  { name: 'MARYLAND', lat: 39.6, lng: -75.7 },
  { name: 'PENNSYLVANIA', lat: 41, lng: -78.3 },
  { name: 'NEW JERSEY', lat: 40.9, lng: -73.6 },
  { name: 'NEW YORK', lat: 42.5, lng: -74.8 },
  { name: 'CONNECTICUT', lat: 41.7, lng: -71.6 },
  { name: 'MASSACHUSETTS', lat: 42.7, lng: -70.6 },
  { name: 'VERMONT', lat: 44.2, lng: -74.6 },
  { name: 'NEW HAMPSHIRE', lat: 44.3, lng: -70.4 },
  { name: 'MAINE', lat: 46.1, lng: -69.2 },
];
const details = posts.map((post) => ({
  day: post.data.day,
  title: post.data.title,
  date: formatDate(post.data.date),
  mileage: post.data.mileage,
  text: excerpt(post, 310),
}));
---

<div class="map-layout">
  <div class="map-canvas">
    <div class="map-label">
      <span class="legend-line"></span> THE APPALACHIAN TRAIL
    </div>
    <div class="map-controls" aria-label="Map zoom controls">
      <button id="zoom-in" aria-label="Zoom in">
        +
      </button>
      <button id="zoom-out" aria-label="Zoom out">
        −
      </button>
      <button id="zoom-reset" aria-label="Reset map view">
        ↺
      </button>
    </div>
    <svg
      id="trail-map"
      viewBox="0 0 820 780"
      role="group"
      aria-label="Interactive Appalachian Trail route from Georgia to Maine. Select a stop or use the day selector to explore the journal."
    >
      <defs>
        <pattern
          id="contours"
          width="170"
          height="170"
          patternUnits="userSpaceOnUse"
        >
          <path
            d="M-50 100Q40-30 100 50T230 70M-40 120Q40-10 100 70T230 90M-30 140Q40 10 100 90T230 110M-20 160Q40 30 100 110T230 130"
            fill="none"
            stroke="#cbd2c3"
            stroke-width=".6"
          />
        </pattern>
      </defs>
      <rect width="820" height="780" fill="#e8eadf" />
      <rect width="820" height="780" fill="url(#contours)" />
      <g class="map-geography">
        {states.map((state) => {
          const p = project(state.lng, state.lat);
          return (
            <text x={p.x} y={p.y}>
              {state.name}
            </text>
          );
        })}
        <text
          class="ocean-label"
          x="630"
          y="500"
          transform="rotate(-50 630 500)"
        >
          ATLANTIC OCEAN
        </text>
        <path
          d="M450 500Q550 470 540 420T610 360T700 230"
          fill="none"
          stroke="#cad6d4"
          stroke-width="80"
          opacity=".3"
        />
      </g>
      <path
        d={path}
        fill="none"
        stroke="#fffdf6"
        stroke-width="7"
        stroke-linejoin="round"
      />
      <path
        d={path}
        fill="none"
        stroke="#9b4c38"
        stroke-width="2.4"
        stroke-linejoin="round"
      />
      {posts.map((post) => {
        const p = project(post.data.longitude, post.data.latitude);
        return (
          <a
            href={`/blog/${post.data.day}/`}
            class="map-stop"
            data-stop={post.data.day}
            aria-label={`Day ${post.data.day}: ${post.data.title}`}
          >
            <circle
              class="stop-target"
              cx={p.x}
              cy={p.y}
              r="7"
              fill="transparent"
            />
            <circle
              class="stop-dot"
              cx={p.x}
              cy={p.y}
              r={post.data.day === 0 || post.data.day === 157 ? 5 : 2.7}
              fill="#9b4c38"
              stroke="#fffdf6"
              stroke-width="1"
            />
            <title>Day {post.data.day}: {post.data.title}</title>
          </a>
        );
      })}
      {[
        [0, 'START · GEORGIA'],
        [157, 'FINISH · KATAHDIN'],
      ].map(([day, label]) => {
        const post = posts.find((p) => p.data.day === day)!;
        const p = project(post.data.longitude, post.data.latitude);
        return (
          <text
            class="terminus-label"
            x={p.x + (day === 0 ? 16 : -16)}
            y={p.y + (day === 0 ? 19 : -16)}
            text-anchor={day === 0 ? 'start' : 'end'}
          >
            {label}
          </text>
        );
      })}
      <circle
        id="selected-stop"
        cx={project(posts[157].data.longitude, posts[157].data.latitude).x}
        cy={project(posts[157].data.longitude, posts[157].data.latitude).y}
        r="8"
        fill="#f8f5ef"
        stroke="#9b4c38"
        stroke-width="3"
        pointer-events="none"
      />
    </svg>
    <p class="map-footnote">
      Original trail coordinates · Scroll to zoom · Drag to explore
    </p>
  </div>
  <aside class="map-detail">
    <p class="eyebrow">ONE DAY AT A TIME</p>
    <label class="day-selector-label" for="trail-day">
      Choose a day on the trail
    </label>
    <select id="trail-day">
      {posts.map((post) => (
        <option value={post.data.day} selected={post.data.day === 157}>
          Day {post.data.day} · {post.data.title}
        </option>
      ))}
    </select>
    <div class="map-detail-content" aria-live="polite">
      <span id="map-day" class="map-day">
        157
      </span>
      <p id="map-date" class="eyebrow">
        August 17, 2022
      </p>
      <h2 id="map-title">Mount Katahdin Summit</h2>
      <p id="map-description">{details[157].text}</p>
      <p class="map-mileage">
        <strong id="map-mileage">15.2</strong> miles today
      </p>
      <a id="map-post" class="button button-rust" href="/blog/157/">
        Read entry ↗
      </a>
    </div>
    <div class="map-step">
      <button id="previous-day">← Previous day</button>
      <button id="next-day" disabled>
        Next day →
      </button>
    </div>
  </aside>
</div>
<script
  type="application/json"
  id="trail-details"
  set:html={JSON.stringify(details).replace(/</g, '\u003c')}
/>
<script>
  interface Detail {
    day: number;
    title: string;
    date: string;
    mileage: number;
    text: string;
  }
  const details: Detail[] = JSON.parse(
    document.querySelector('#trail-details')!.textContent!,
  );
  const select = document.querySelector<HTMLSelectElement>('#trail-day')!;
  const svg = document.querySelector<SVGSVGElement>('#trail-map')!;
  const prev = document.querySelector<HTMLButtonElement>('#previous-day')!;
  const next = document.querySelector<HTMLButtonElement>('#next-day')!;
  let day = 157;
  function choose(value: number) {
    const detail = details.find((p) => p.day === value);
    if (!detail) return;
    day = value;
    select.value = String(value);
    for (const [id, text] of Object.entries({
      'map-day': String(day).padStart(2, '0'),
      'map-date': detail.date,
      'map-title': detail.title,
      'map-description': detail.text,
      'map-mileage': String(detail.mileage),
    }))
      document.getElementById(id)!.textContent = text;
    (document.querySelector('#map-post') as HTMLAnchorElement).href =
      `/blog/${day}/`;
    const dot = svg.querySelector(`[data-stop="${day}"] .stop-dot`)!;
    const marker = document.querySelector('#selected-stop')!;
    marker.setAttribute('cx', dot.getAttribute('cx')!);
    marker.setAttribute('cy', dot.getAttribute('cy')!);
    svg.querySelectorAll('[data-stop]').forEach((stop) => {
      if (stop.getAttribute('data-stop') === String(day))
        stop.setAttribute('aria-current', 'true');
      else stop.removeAttribute('aria-current');
    });
    prev.disabled = day === 0;
    next.disabled = day === 157;
    const url = new URL(location.href);
    url.searchParams.set('day', String(day));
    history.replaceState(null, '', url);
  }
  select.addEventListener('change', () => choose(Number(select.value)));
  svg.querySelectorAll<SVGAElement>('[data-stop]').forEach((stop) =>
    stop.addEventListener('click', (event) => {
      event.preventDefault();
      choose(Number(stop.dataset.stop));
    }),
  );
  prev.addEventListener('click', () => choose(day - 1));
  next.addEventListener('click', () => choose(day + 1));
  const initial = new URLSearchParams(location.search).get('day');
  if (initial !== null && /^\d+$/.test(initial)) choose(Number(initial));
  let box = { x: 0, y: 0, w: 820, h: 780 };
  function draw() {
    svg.setAttribute('viewBox', `${box.x} ${box.y} ${box.w} ${box.h}`);
  }
  function zoom(factor: number) {
    const w = Math.max(140, Math.min(820, box.w * factor)),
      h = (w * 780) / 820;
    box = { x: box.x + (box.w - w) / 2, y: box.y + (box.h - h) / 2, w, h };
    draw();
  }
  document
    .querySelector('#zoom-in')!
    .addEventListener('click', () => zoom(0.75));
  document
    .querySelector('#zoom-out')!
    .addEventListener('click', () => zoom(1.33));
  document.querySelector('#zoom-reset')!.addEventListener('click', () => {
    box = { x: 0, y: 0, w: 820, h: 780 };
    draw();
  });
  svg.addEventListener(
    'wheel',
    (event) => {
      if (
        event.ctrlKey ||
        event.metaKey ||
        window.matchMedia('(min-width: 768px)').matches
      ) {
        event.preventDefault();
        zoom(event.deltaY > 0 ? 1.1 : 0.9);
      }
    },
    { passive: false },
  );
  let drag: { x: number; y: number; bx: number; by: number } | null = null;
  svg.addEventListener('pointerdown', (event) => {
    if ((event.target as Element).closest('[data-stop]')) return;
    drag = { x: event.clientX, y: event.clientY, bx: box.x, by: box.y };
    svg.setPointerCapture(event.pointerId);
  });
  svg.addEventListener('pointermove', (event) => {
    if (!drag) return;
    const rect = svg.getBoundingClientRect();
    box.x = drag.bx - ((event.clientX - drag.x) * box.w) / rect.width;
    box.y = drag.by - ((event.clientY - drag.y) * box.h) / rect.height;
    draw();
  });
  svg.addEventListener('pointerup', () => {
    drag = null;
  });
  svg.addEventListener('pointercancel', () => {
    drag = null;
  });
</script>
