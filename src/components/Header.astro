---
import { Image } from 'astro:assets';
import logo from '../assets/images/logo.png';
import { nav } from '../data/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<a
  href="#main"
  class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:bg-cream focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-bark"
>
  Skip to content
</a>

<header class="relative z-40 border-b border-cream bg-bark">
  <div class="page-container flex h-header items-center justify-between gap-8 lg:h-header-lg">
    <a href="/" class="-ml-1 shrink-0 p-1" aria-label="Jimmy on the Trail, home">
      <Image
        src={logo}
        alt=""
        height={72}
        densities={[1, 2]}
        loading="eager"
        class="h-11 w-auto sm:h-14 lg:h-[4.5rem]"
      />
    </a>

    <nav aria-label="Main" class="hidden md:block">
      <ul class="flex items-center gap-7 lg:gap-10">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
                class="relative py-2 text-[0.95rem] font-medium tracking-[0.06em] text-cream transition-colors hover:text-rust-300 aria-[current=page]:text-rust-300 lg:text-base"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button
      type="button"
      id="menu-toggle"
      class="-mr-2 inline-flex h-11 w-11 items-center justify-center text-cream md:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="sr-only">Open menu</span>
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M3 6h18M3 12h18M3 18h12" />
      </svg>
    </button>
  </div>
</header>

<!--
  Full-height mobile menu. It sits outside <header> so the rest of the page can be made
  inert while it is open. Closed: `inert` + invisible (after the fade), so it is neither
  focusable nor announced.
-->
<div
  id="mobile-menu"
  inert
  class="mobile-menu group fixed inset-x-0 top-0 z-50 flex h-dvh flex-col bg-bark md:hidden"
>
  <div class="border-b border-cream">
    <div class="page-container flex h-header items-center justify-between gap-8">
      <a href="/" class="-ml-1 shrink-0 p-1" aria-label="Jimmy on the Trail, home" data-menu-link>
        <Image src={logo} alt="" height={72} densities={[1, 2]} class="h-11 w-auto sm:h-14" />
      </a>
      <button
        type="button"
        data-menu-close
        class="-mr-2 inline-flex h-11 w-11 items-center justify-center text-cream"
        aria-expanded="true"
        aria-controls="mobile-menu"
      >
        <span class="sr-only">Close menu</span>
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M5 5l14 14M19 5L5 19" />
        </svg>
      </button>
    </div>
  </div>

  <nav aria-label="Main" class="flex-1 overflow-y-auto">
    <ul class="page-container flex flex-col pt-6 pb-10">
      {
        nav.map((item, index) => (
          <li
            class="border-b border-cream/15 opacity-0 translate-y-2 transition-[opacity,transform] duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] group-data-[open]:translate-y-0 group-data-[open]:opacity-100 motion-reduce:translate-y-0"
            style={`transition-delay: ${80 + index * 40}ms`}
          >
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
              data-menu-link
              class="flex min-h-16 items-center py-3 font-display text-[2.25rem] leading-none text-cream hover:text-rust-300 aria-[current=page]:text-rust-300"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</div>

<style>
  /* Fade + short slide. Visibility turns on instantly when opening (so focus can move in)
     and only turns off after the closing fade, so the closed panel is never focusable. */
  .mobile-menu {
    opacity: 0;
    visibility: hidden;
    transform: translateY(-1rem);
    transition:
      opacity 300ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 300ms cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s linear 300ms;
  }

  .mobile-menu[data-open] {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-menu {
      transform: none;
    }
  }
</style>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  if (toggle && menu) {
    const closeButton = menu.querySelector<HTMLButtonElement>('[data-menu-close]');
    const firstLink = menu.querySelector<HTMLAnchorElement>('nav a');
    const root = document.documentElement;
    // Everything except the menu becomes inert while it is open, which keeps focus inside.
    const outside = () => Array.from(document.body.children).filter((el) => el !== menu);
    let isOpen = false;

    const setOpen = (open: boolean, { restoreFocus = true } = {}) => {
      if (open === isOpen) return;
      isOpen = open;
      toggle.setAttribute('aria-expanded', String(open));
      menu.toggleAttribute('data-open', open);
      menu.inert = !open;
      for (const el of outside()) (el as HTMLElement).inert = open;
      root.style.overflow = open ? 'hidden' : '';
      if (open) {
        (firstLink ?? closeButton)?.focus();
      } else if (restoreFocus) {
        toggle.focus();
      }
    };

    toggle.addEventListener('click', () => setOpen(true));
    closeButton?.addEventListener('click', () => setOpen(false));

    // Tapping a link closes the menu (and leaves focus alone, since the page is changing).
    menu.querySelectorAll('[data-menu-link]').forEach((link) =>
      link.addEventListener('click', () => setOpen(false, { restoreFocus: false })),
    );

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isOpen) setOpen(false);
    });

    window.matchMedia('(min-width: 48rem)').addEventListener('change', (event) => {
      if (event.matches) setOpen(false, { restoreFocus: false });
    });

    // Back/forward cache: never restore a page with the menu still open.
    window.addEventListener('pageshow', () => setOpen(false, { restoreFocus: false }));
  }
</script>
