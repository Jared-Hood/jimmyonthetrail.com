---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { defaultOgCard, site, type PageMeta } from '../data/site';

interface Props {
  page: PageMeta;
  image?: ImageMetadata;
  imageAlt?: string;
}

const { page, image, imageAlt } = Astro.props;

const siteUrl = Astro.site ?? new URL(site.url);
const title = page.title ?? `${page.name} | ${site.name}`;
const canonical = new URL(page.slug ? `/${page.slug}` : '/', siteUrl).href;

// Pages can pass their own photo (e.g. a day's lead photo); everything else uses the default
// share card built by scripts/build-og-image.mjs.
const og = image
  ? await getImage({ src: image, width: Math.min(1200, image.width), format: 'jpg', quality: 80 })
  : undefined;
const ogImage = new URL(og ? og.src : defaultOgCard.path, siteUrl).href;
const ogWidth = og ? og.attributes.width : defaultOgCard.width;
const ogHeight = og ? og.attributes.height : defaultOgCard.height;
const ogAlt = image ? (imageAlt ?? '') : defaultOgCard.alt;
---

<title>{title}</title>
<meta name="description" content={page.description} />
<meta name="keywords" content={site.keywords.join(', ')} />
<link rel="canonical" href={canonical} />

<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={page.description} />
<meta property="og:type" content={site.ogType} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
{ogWidth && <meta property="og:image:width" content={String(ogWidth)} />}
{ogHeight && <meta property="og:image:height" content={String(ogHeight)} />}
<meta property="og:image:alt" content={ogAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={ogAlt} />
