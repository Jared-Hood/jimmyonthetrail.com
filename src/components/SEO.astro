---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { site, type PageMeta } from '../data/site';
import defaultOgImage from '../assets/images/skyline.jpeg';

interface Props {
  page: PageMeta;
  image?: ImageMetadata;
  imageAlt?: string;
}

const { page, image = defaultOgImage, imageAlt = 'Blue ridges of the Appalachian Mountains under a hazy sky' } =
  Astro.props;

const siteUrl = Astro.site ?? new URL(site.url);
const title = page.title ?? `${page.name} | ${site.name}`;
const canonical = new URL(page.slug ? `/${page.slug}` : '/', siteUrl).href;

const og = await getImage({ src: image, width: 1200, format: 'jpg', quality: 80 });
const ogImage = new URL(og.src, siteUrl).href;
---

<title>{title}</title>
<meta name="description" content={page.description} />
<meta name="keywords" content={site.keywords.join(', ')} />
<link rel="canonical" href={canonical} />

<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={page.description} />
<meta property="og:type" content={site.ogType} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content={String(og.attributes.width ?? 1200)} />
<meta property="og:image:height" content={String(og.attributes.height ?? '')} />
<meta property="og:image:alt" content={imageAlt} />
<meta name="twitter:card" content="summary_large_image" />
