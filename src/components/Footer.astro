---
import { nav, site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-cream/15 bg-ink-900">
  <div class="page-container grid gap-10 py-block md:grid-cols-[1fr_auto] md:items-end">
    <div>
      <p class="font-display text-2xl text-cream">{site.name}</p>
      <p class="mt-2 text-sm text-cream-400">
        Springer Mountain, Georgia to Mount Katahdin, Maine &middot; 2022
      </p>
    </div>

    <nav aria-label="Footer">
      <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm font-medium tracking-[0.06em]">
        <li><a href="/" class="text-cream-200 hover:text-rust-300">Home</a></li>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="text-cream-200 hover:text-rust-300">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="page-container flex flex-wrap items-center justify-between gap-4 border-t border-cream/10 py-6 text-xs text-cream-600">
    <p>&copy; {year} jimmyonthetrail.com</p>
    <a href="#top" class="hover:text-cream">Back to top &uarr;</a>
  </div>
</footer>
