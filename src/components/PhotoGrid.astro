---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  photos: { src: ImageMetadata; alt: string }[];
  label?: string;
}

const { photos, label = 'Photos' } = Astro.props;
const single = photos.length === 1;
---

{
  photos.length > 0 && (
    <ul class:list={['gap-4', single ? 'block' : 'columns-1 sm:columns-2']} aria-label={label}>
      {photos.map((photo) => (
        <li class="mb-4 break-inside-avoid">
          <Image
            src={photo.src}
            alt={photo.alt}
            format="webp"
            widths={single ? [480, 800, 1200, 1600] : [400, 600, 800, 1200]}
            width={Math.min(photo.src.width, single ? 1600 : 1200)}
            quality={70}
            loading="lazy"
            decoding="async"
            sizes={
              single
                ? '(min-width: 96rem) 1488px, (min-width: 80rem) 1232px, calc(100vw - 2rem)'
                : '(min-width: 96rem) 736px, (min-width: 80rem) 608px, (min-width: 40rem) calc(50vw - 2rem), calc(100vw - 2rem)'
            }
            class="h-auto w-full rounded-photo bg-bark"
          />
        </li>
      ))}
    </ul>
  )
}
