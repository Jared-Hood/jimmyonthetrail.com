---
interface Props {
  title: string;
  eyebrow?: string;
  /** Extra classes for the outer section (e.g. tighter bottom padding). */
  class?: string;
}

const { title, eyebrow, class: className } = Astro.props;
---

<section class:list={['border-b border-cream/15 pt-block pb-10 lg:pt-20 lg:pb-14', className]}>
  <div class="page-container">
    <slot name="before" />
    {eyebrow && <p class="eyebrow mb-4">{eyebrow}</p>}
    <h1 class="font-display text-3xl font-normal text-cream sm:text-[clamp(2.75rem,1.8rem+3vw,4.25rem)] sm:leading-none">
      {title}
    </h1>
    <slot />
  </div>
</section>
