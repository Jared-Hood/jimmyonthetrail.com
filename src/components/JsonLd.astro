---
/** Renders one JSON-LD block. "<" is escaped so the JSON can never close the script tag. */
interface Props {
  data: Record<string, unknown> | Record<string, unknown>[];
}

const json = JSON.stringify(Astro.props.data).replace(/</g, '\\u003c');
---

<script type="application/ld+json" set:html={json} />
