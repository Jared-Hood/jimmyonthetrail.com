---
import type { ImageMetadata } from 'astro';
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { PageMeta } from '../data/site';

interface Props {
  page: PageMeta;
  image?: ImageMetadata;
  imageAlt?: string;
  noindex?: boolean;
}

const { page, image, imageAlt, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en" id="top">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <link rel="preload" href="/fonts/Heading.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Montserrat-ExtraLight.woff2" as="font" type="font/woff2" crossorigin />

    <SEO page={page} image={image} imageAlt={imageAlt} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#9b4c38" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="msapplication-TileColor" content="#413333" />
    <meta name="theme-color" content="#413333" />
    {noindex && <meta name="robots" content="noindex" />}
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <Header />
    <main id="main" tabindex="-1" class="flex-1 focus:outline-none">
      <slot />
    </main>
    <Footer />
  </body>
</html>
