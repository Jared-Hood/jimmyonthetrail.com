{
  "hosting": {
    "public": "dist",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/index.html",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/gear.html",
        "destination": "/gear",
        "type": 301
      },
      {
        "source": "/blog.html",
        "destination": "/blog",
        "type": 301
      },
      {
        "source": "/map.html",
        "destination": "/map",
        "type": 301
      },
      {
        "source": "/wishes.html",
        "destination": "/wishes",
        "type": 301
      },
      {
        "source": "/gallery.html",
        "destination": "/gallery",
        "type": 301
      },
      {
        "source": "/blog/:day.html",
        "destination": "/blog/:day",
        "type": 301
      }
    ],
    "headers": [
      {
        "regex": "^(?:/(?:_astro|fonts)/)?[^.]*$|\\.html$",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/_astro/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/fonts/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(png|jpg|jpeg|webp|avif|svg|ico|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          }
        ]
      }
    ]
  }
}
