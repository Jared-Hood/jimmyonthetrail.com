{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jimmyonthetrail",
  "compatibility_date": "2026-10-18",
  "assets": {
    "directory": "./dist",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page",
  },
  "observability": {
    "enabled": true,
    "traces": { "enabled": true },
  },
}
